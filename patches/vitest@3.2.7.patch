+// Patched for ticket #437: the worker's RPC watchdog is birpc's hard-coded 60 s DEFAULT_TIMEOUT, with no
+// option behind it. VITEST_WORKER_RPC_TIMEOUT_MS replaces it when it is a whole number of milliseconds from 1 to
+// the largest delay setTimeout honours (a larger one fires at once); anything else keeps the default.
+const MAX_TIMER_DELAY_MS = 2147483647;
+function workerRpcTimeout() {
+	const configured = globalThis.process?.env?.VITEST_WORKER_RPC_TIMEOUT_MS ?? "";
+	if (!/^\d+$/.test(configured)) return undefined;
+	const milliseconds = Number(configured);
+	return milliseconds >= 1 && milliseconds <= MAX_TIMER_DELAY_MS ? milliseconds : undefined;
